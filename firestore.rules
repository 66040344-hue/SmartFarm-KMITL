rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = บัญชีที่ล็อกอินด้วยอีเมล/รหัสผ่าน (สร้างใน Firebase Authentication)
    // นักศึกษาใช้ Google (sign_in_provider == 'google.com') จึงไม่ถูกนับเป็น Admin
    // ต้องปิด "Enable create (sign-up)" ใน Authentication > Settings > User actions
    // ไม่เช่นนั้นใครก็สมัครบัญชีรหัสผ่านผ่าน API แล้วกลายเป็น Admin ได้
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // นักศึกษาเจ้าของ doc: อีเมล = <รหัส 8 หลัก>@kmitl.ac.th
    function isOwner(studentId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == studentId + '@kmitl.ac.th';
    }

    match /students/{studentId} {
      // TODO: หากหน้าอื่น (เช่น ค้นหาหัวข้อสัมมนา) ไม่ต้องอ่านแบบไม่ล็อกอิน
      // ให้เปลี่ยนเป็น: allow read: if isAdmin() || isOwner(studentId);
      allow read: if true;

      // Admin แก้ได้ทุกฟิลด์
      allow update: if isAdmin();

      // นักศึกษาแก้ได้เฉพาะฟิลด์การส่งงานของตัวเอง ห้ามแตะ evalStatus/evalFeedback/name ฯลฯ
      allow update: if isOwner(studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['submissionUrl', 'submissionFileUrl', 'submissionType', 'submissionFileName', 'submittedAt',
                       'evalStatus', 'evalFeedback'])
        // แตะ evalStatus/evalFeedback ได้เฉพาะ "ลบทิ้ง" ตอนส่งใหม่หลัง Admin รีเซ็ตเป็น notsubmitted
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['evalStatus', 'evalFeedback'])
            || (resource.data.get('evalStatus', '') == 'notsubmitted'
                && !('evalStatus' in request.resource.data)
                && !('evalFeedback' in request.resource.data)));

      allow create, delete: if isAdmin();
    }

    // เบอร์โทรนักศึกษา (ข้อมูลส่วนบุคคล) แยกจาก students เพราะ students อ่านได้แบบสาธารณะ
    // อ่านได้เฉพาะ Admin และเจ้าของเท่านั้น
    match /contacts/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow write: if isAdmin();
      allow create, update: if isOwner(studentId)
        && request.resource.data.keys().hasOnly(['phone', 'updatedAt'])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10}$');
    }

    // ================= ระบบประเมินการนำเสนอ (seminar-eval.html) =================
    // เข้าได้เฉพาะ Google @kmitl.ac.th ที่ไม่ใช่บัญชีนักศึกษา (รหัส 8 หลัก)
    // และต้องมีชื่ออยู่ใน evalUsers/{email} ที่ผู้ดูแลเพิ่มไว้เท่านั้น
    // ผู้ดูแลระบบถาวร (ข้อยกเว้นบัญชีนักศึกษา) — เป็นผู้ดูแลและทดลองให้คะแนนได้โดยไม่ต้องมีใน evalUsers
    // ต้องตรงกับ SUPER_ADMINS ใน seminar-eval-api.js
    function isEvalSuperAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['66040344@kmitl.ac.th'];
    }
    function isKmitlStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@kmitl[.]ac[.]th$')
        && !request.auth.token.email.matches('^[0-9]{8}@kmitl[.]ac[.]th$');
    }
    function evalUserPath() {
      return /databases/$(database)/documents/evalUsers/$(request.auth.token.email);
    }
    function isEvalMember() {
      return isEvalSuperAdmin() || (isKmitlStaff() && exists(evalUserPath()));
    }
    function isEvalAdmin() {
      return isEvalSuperAdmin()
        || (isKmitlStaff() && exists(evalUserPath()) && get(evalUserPath()).data.role in ['admin', 'both']);
    }
    // ผู้ดูแลถาวรทดลองให้คะแนนได้ (ไม่นับในสรุปเพราะไม่อยู่ใน evalUsers)
    function isEvalGrader() {
      return isEvalSuperAdmin()
        || (isKmitlStaff() && exists(evalUserPath())
            && get(evalUserPath()).data.role in ['teacher', 'both']);
    }
    function halfStep(v, max) {
      return v is number && v >= 0 && v <= max && v * 2 == math.floor(v * 2);
    }
    // คะแนนเต็มรายข้อ: ผู้ดูแลแก้ได้ในหน้าเว็บ (เก็บที่ evalConfig/main.maxes = { c1: 25, ... })
    // ถ้ายังไม่เคยแก้ ใช้ค่าเริ่มต้นเดียวกับ seminar-eval-data.js
    // รหัสข้อเป็น c1..c20 เท่านั้น (ถ้าจะเพิ่มเกิน 20 ข้อ ต้องเพิ่มใน itemOk และผลรวมด้านล่าง และ MAX_ITEMS ใน seminar-eval-api.js)
    function evalMaxes() {
      return exists(/databases/$(database)/documents/evalConfig/main)
          && 'maxes' in get(/databases/$(database)/documents/evalConfig/main).data
        ? get(/databases/$(database)/documents/evalConfig/main).data.maxes
        : {'c1': 25, 'c2': 10, 'c3': 5, 'c4': 20, 'c5': 10, 'c6': 10, 'c7': 10, 'c8': 10};
    }
    function itemOk(items, id, m) {
      return !(id in items) || halfStep(items[id], m.get(id, -1));
    }
    function validEvalScore(d) {
      let m = evalMaxes();
      let it = d.items;
      return d.keys().hasOnly(['sid', 'email', 'name', 'date', 'items', 'total', 'comment', 'updatedAt'])
        && d.sid is string && d.sid.matches('^[0-9]{8}$')
        && d.email == request.auth.token.email
        && d.name is string && d.name.size() <= 200
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && it.keys().hasOnly(m.keys()) && it.keys().hasAll(m.keys())
        && itemOk(it, 'c1', m) && itemOk(it, 'c2', m) && itemOk(it, 'c3', m) && itemOk(it, 'c4', m)
        && itemOk(it, 'c5', m) && itemOk(it, 'c6', m) && itemOk(it, 'c7', m) && itemOk(it, 'c8', m)
        && itemOk(it, 'c9', m) && itemOk(it, 'c10', m) && itemOk(it, 'c11', m) && itemOk(it, 'c12', m)
        && itemOk(it, 'c13', m) && itemOk(it, 'c14', m) && itemOk(it, 'c15', m) && itemOk(it, 'c16', m)
        && itemOk(it, 'c17', m) && itemOk(it, 'c18', m) && itemOk(it, 'c19', m) && itemOk(it, 'c20', m)
        && d.total == it.get('c1', 0) + it.get('c2', 0) + it.get('c3', 0) + it.get('c4', 0)
                    + it.get('c5', 0) + it.get('c6', 0) + it.get('c7', 0) + it.get('c8', 0)
                    + it.get('c9', 0) + it.get('c10', 0) + it.get('c11', 0) + it.get('c12', 0)
                    + it.get('c13', 0) + it.get('c14', 0) + it.get('c15', 0) + it.get('c16', 0)
                    + it.get('c17', 0) + it.get('c18', 0) + it.get('c19', 0) + it.get('c20', 0)
        && d.comment is string && d.comment.size() <= 1000
        && d.updatedAt == request.time;
    }
    // ใบประเมินเก่า = ตั้ง liveFrom ไว้ + ถึงเวลานั้นแล้ว + ใบนี้บันทึกก่อนเวลานั้น (ใช้ใน delete เท่านั้น)
    function staleScore() {
      return exists(/databases/$(database)/documents/evalConfig/main)
        && get(/databases/$(database)/documents/evalConfig/main).data.get('liveFrom', null) != null
        && request.time >= get(/databases/$(database)/documents/evalConfig/main).data.liveFrom
        && resource.data.updatedAt < get(/databases/$(database)/documents/evalConfig/main).data.liveFrom;
    }
    function dayOpen(date) {
      return !exists(/databases/$(database)/documents/evalConfig/main)
        || !(date in get(/databases/$(database)/documents/evalConfig/main).data.get('locked', {}));
    }

    match /evalUsers/{email} {
      // อ่านเอกสารของตัวเองได้ (ใช้ตรวจสิทธิ์ตอนล็อกอิน) / ผู้ดูแลอ่านได้ทั้งหมด
      allow get: if isKmitlStaff() && email == request.auth.token.email;
      allow read: if isEvalAdmin();
      allow create, update: if isEvalAdmin()
        && email.matches('^[^@]+@kmitl[.]ac[.]th$')
        && !email.matches('^[0-9]{8}@kmitl[.]ac[.]th$')
        && request.resource.data.keys().hasOnly(['name', 'role', 'order'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.role in ['teacher', 'admin', 'both'];
      allow delete: if isEvalAdmin();
    }

    match /evalConfig/{docId} {
      allow read: if isEvalMember();
      allow write: if isEvalAdmin() && docId == 'main'
        && request.resource.data.keys().hasOnly(['locked', 'criteria', 'maxes', 'liveFrom', 'updatedAt', 'updatedBy']);
    }

    // doc id = <รหัสนักศึกษา>__<อีเมลอาจารย์> → อาจารย์ 1 ท่านมีคะแนนได้ 1 ชุดต่อนักศึกษา 1 คน
    match /evalScores/{scoreId} {
      allow read: if isEvalAdmin()
        || (isEvalMember() && resource.data.email == request.auth.token.email);
      allow create: if isEvalGrader()
        && scoreId == request.resource.data.sid + '__' + request.auth.token.email
        && validEvalScore(request.resource.data)
        && dayOpen(request.resource.data.date);
      allow update: if isEvalGrader()
        && resource.data.email == request.auth.token.email
        && scoreId == request.resource.data.sid + '__' + request.auth.token.email
        && request.resource.data.date == resource.data.date
        && validEvalScore(request.resource.data)
        && dayOpen(request.resource.data.date);
      // ลบได้เฉพาะผู้ดูแลถาวร (ใช้ลบคะแนนทดลองของตัวเอง และล้างคะแนนทดสอบของกรรมการก่อนวันจริง) — อาจารย์ลบ/แก้คะแนนของคนอื่นไม่ได้
      // และลบอัตโนมัติได้เมื่อถึงเวลาเริ่มนับจริง (evalConfig/main.liveFrom): ลบได้เฉพาะใบที่บันทึกก่อน liveFrom และหลัง liveFrom มาถึงแล้วเท่านั้น
      // (ผู้ดูแลลบได้ทุกใบ อาจารย์ลบได้เฉพาะของตัวเอง) — ใบที่บันทึกหลัง liveFrom ลบไม่ได้
      allow delete: if isEvalSuperAdmin()
        || (isEvalMember() && staleScore() && (isEvalAdmin() || resource.data.email == request.auth.token.email));
    }
  }
}
